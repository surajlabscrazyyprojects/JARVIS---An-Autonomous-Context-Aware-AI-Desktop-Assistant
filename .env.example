# J.A.R.V.I.S. Environment Template
# =================================
# Copy this file to .env and fill in your own credentials.
#   cp .env.example .env
# Never commit .env (it is gitignored). Only .env.example is public.
#
# Free-mode defaults below match voice plan prompt §4 exactly.
# Fish Audio s2.1-pro-free is fair-use free for dev/testing; paid models
# require ALLOW_PAID_FISH_MODELS=true (§4, §14). Never commit real keys.

# -----------------------------------------------------------
# GROQ - Conversational Intelligence (required for chat/brain)
# Get yours at: https://console.groq.com/keys
# -----------------------------------------------------------
GROQ_API_KEY=
JARVIS_CONVERSATION_PROVIDER=groq
JARVIS_CONVERSATION_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------
# GEMINI - Alternative provider (optional)
# Get yours at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------
# Fish Audio - Text-to-Speech (primary TTS, §4)
# Docs: https://docs.fish.audio/developer-guide/getting-started/quickstart
# Voice IDs: https://fish.audio/app/ -> your models -> reference_id
# Default free config (copy verbatim when filling .env):
#   TTS_PROVIDER=fish
#   FISH_API_KEY=sk-...
#   FISH_REFERENCE_ID=<voice you are authorized to use>
#   FISH_MODEL=s2.1-pro-free
#   FISH_BASE_URL=https://api.fish.audio
#   FISH_TTS_WEBSOCKET_URL=wss://api.fish.audio/v1/tts/live
#   FISH_LATENCY=balanced
#   FISH_FORMAT=pcm
#   FISH_SAMPLE_RATE=24000
#   FISH_CHUNK_LENGTH=200
#   FISH_MIN_CHUNK_LENGTH=50
#   FISH_TEMPERATURE=0.70
#   FISH_TOP_P=0.70
#   FISH_REPETITION_PENALTY=1.20
#   FISH_NORMALIZE=true
#   FISH_CONDITION_ON_PREVIOUS_CHUNKS=true
#   FISH_TTS_TIMEOUT_MS=15000
#   FISH_CONNECT_TIMEOUT_MS=5000
#   FISH_MAX_RETRIES=1
#   FISH_CACHE_ENABLED=true
#   FISH_CACHE_MAX_MB=128
#   FISH_ALLOW_PRIVATE_RESPONSE_CACHE=false
#   ALLOW_PAID_FISH_MODELS=false
# -----------------------------------------------------------
TTS_PROVIDER=fish
FISH_API_KEY=
FISH_AUDIO_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=s2.1-pro-free
FISH_BASE_URL=https://api.fish.audio
FISH_TTS_WEBSOCKET_URL=wss://api.fish.audio/v1/tts/live
FISH_LATENCY=balanced
FISH_FORMAT=pcm
FISH_SAMPLE_RATE=24000
FISH_CHUNK_LENGTH=200
FISH_MIN_CHUNK_LENGTH=50
FISH_TEMPERATURE=0.70
FISH_TOP_P=0.70
FISH_REPETITION_PENALTY=1.20
FISH_NORMALIZE=true
FISH_CONDITION_ON_PREVIOUS_CHUNKS=true
FISH_TTS_TIMEOUT_MS=15000
FISH_CONNECT_TIMEOUT_MS=5000
FISH_MAX_RETRIES=1
FISH_CACHE_ENABLED=true
FISH_CACHE_MAX_MB=128
FISH_ALLOW_PRIVATE_RESPONSE_CACHE=false
ALLOW_PAID_FISH_MODELS=false
# Local usage guards (§14) — conservative defaults for a personal assistant
FISH_MAX_REQUESTS_PER_MINUTE=20
FISH_MAX_UTF8_BYTES_PER_SESSION=200000
FISH_MAX_RESPONSE_LENGTH=2000
FISH_MAX_CONCURRENT_STREAMS=1
FISH_VOLUME_DB=0
# Back-compat aliases still honored by VoiceConfig
FISH_AUDIO_MODEL=s2.1-pro-free
JARVIS_TTS_PROVIDER=fish
JARVIS_TTS_MODEL=s2.1-pro-free

# Hume Octave (authoritative JARVIS voice when enabled; credentials stay server-side)
# Set JARVIS_TTS_ENGINE=hume and provide HUME_API_KEY to use it.
# HUME_API_KEY=your_hume_api_key_here
# HUME_SECRET_KEY=your_hume_secret_key_here
# HUME_VOICE_ID=89989d92-1de8-4e5d-97e4-23cd363e9788
# HUME_VOICE_PROVIDER=HUME_AI
# HUME_TTS_URL=https://api.hume.ai/v0/tts

# -----------------------------------------------------------
# ElevenLabs - Alternative TTS (optional, not the default)
# Get yours at: https://elevenlabs.io/
# -----------------------------------------------------------
ELEVENLABS_API_KEY=
BRAINROT_JARVIS_VOICE_ID=
DEFAULT_TTS_PROVIDER=elevenlabs

# --- Local expressive voice engine (fallback) ---
# No API keys required for local TTS. Kept for §15 fallback only.
VOICE_ENGINE=fish
VOICE_DEVICE=cpu
VOICE_ENABLED=true
VOICE_HTTP_HOST=127.0.0.1
VOICE_HTTP_PORT=8766
VOICE_REFERENCE=voice/references/jarvis_reference.wav
VOICE_TEMPERATURE=0.85
VOICE_TOP_P=0.95
VOICE_TOP_K=1000
VOICE_REPETITION_PENALTY=1.2
VOICE_CHARACTER=IRON_MAN
CHARACTER_ENERGY=0.62
CHARACTER_PLAYFULNESS=0.66
CHARACTER_EXPRESSIVENESS=0.72
VOICE_MODEL_CACHE=
VOICE_MAX_TEXT_CHARS=2000
